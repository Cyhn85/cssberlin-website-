# ============================================
# CSS BERLIN - ENVIRONMENT VARIABLES (TEMPLATE)
# Copy this file to .env and fill in YOUR REAL values
# DO NOT COMMIT REAL SECRETS TO THIS FILE
# ============================================

# ===========================================
# DATABASE (Required)
# ===========================================
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# ===========================================
# CLERK AUTHENTICATION (Required)
# ===========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_PLACEHOLDER"
CLERK_SECRET_KEY="sk_test_PLACEHOLDER"

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ===========================================
# DOCKER COMPOSE (Optional)
# ===========================================
POSTGRES_USER="cssberlin"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="cssberlin"

# ===========================================
# OPTIONAL SERVICES
# ===========================================
# Uploadthing
# UPLOADTHING_SECRET="sk_live_PLACEHOLDER"
# UPLOADTHING_APP_ID="PLACEHOLDER"

# Stripe
# STRIPE_SECRET_KEY="sk_test_PLACEHOLDER"
# STRIPE_WEBHOOK_SECRET="whsec_PLACEHOLDER"
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_PLACEHOLDER"

# Resend (Email)
# RESEND_API_KEY="re_PLACEHOLDER"

# Clerk Webhook
# WEBHOOK_SECRET="whsec_PLACEHOLDER"

# Base URL (for emails and redirects)
NEXT_PUBLIC_BASE_URL="https://cssberlin.de"