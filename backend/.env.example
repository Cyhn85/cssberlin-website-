# ═══════════════════════════════════════════════════════════════
# CSS Berlin Backend Environment Variables
# Copy this file to .env and fill in your credentials
# ═══════════════════════════════════════════════════════════════

# ─── JWT Secret Key ─────────────────────────────────────────
SECRET_KEY=super_secret_key_css_berlin_2026_change_this_in_production

# ─── Frontend & Backend URLs ────────────────────────────────
FRONTEND_URL=http://localhost:5500
BACKEND_URL=http://localhost:8000

# ─── Google OAuth 2.0 ───────────────────────────────────────
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Apple Sign In (Optional) ───────────────────────────────
APPLE_CLIENT_ID=com.cssberlin.signin
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID

# ─── Email (SMTP for Magic Link) ───────────────────────────
# Gmail example:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@cssberlin.de

# OR use SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./cssberlin.db

# ─── Stripe Payment (Optional) ──────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
