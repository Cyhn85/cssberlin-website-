# ═══════════════════════════════════════════════════════════════
# CSS Berlin Backend Environment Variables
# Copy this file to .env and fill in your credentials
# ═══════════════════════════════════════════════════════════════

# ─── JWT Secret Key ─────────────────────────────────────────
SECRET_KEY=super_secret_key_css_berlin_2026_change_this_in_production

# ─── Frontend & Backend URLs ────────────────────────────────
FRONTEND_URL=http://localhost:5500
BACKEND_URL=http://localhost:8000

# ─── Google OAuth 2.0 ───────────────────────────────────────
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Apple Sign In (Optional) ───────────────────────────────
APPLE_CLIENT_ID=com.cssberlin.signin
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID

# ─── Email (SMTP - IONOS) ──────────────────────────────────
# Magic Link & Password Reset → noreply@cssberlin.de
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER_MAGIC=noreply@cssberlin.de
SMTP_PASSWORD_MAGIC=your-password-here
FROM_EMAIL_MAGIC=noreply@cssberlin.de

# General Info & Notifications → info@cssberlin.de
SMTP_USER_INFO=info@cssberlin.de
SMTP_PASSWORD_INFO=your-password-here
FROM_EMAIL_INFO=info@cssberlin.de

# Default sender (Magic Link için)
SMTP_USER=noreply@cssberlin.de
SMTP_PASSWORD=your-password-here
FROM_EMAIL=noreply@cssberlin.de

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./cssberlin.db

# ─── Stripe Payment (Optional) ──────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
