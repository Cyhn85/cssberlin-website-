[Unit]
Description=CSS Berlin Backend API
After=network.target

[Service]
User=root
WorkingDirectory=/root/cssberlin-website-
ExecStart=/usr/bin/python3 backend/main.py
Restart=always
RestartSec=5
EnvironmentFile=/root/cssberlin-website-/backend/.env
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=cssberlin-backend

[Install]
WantedBy=multi-user.target
